{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "sin1"
  ],
  "functions": {
    "api/**/*.ts": {
      "memory": 2048,
      "maxDuration": 120,
      "includeFiles": "node_modules/axe-core/axe.min.js"
    }
  },
  "rewrites": [
    {
      "source": "/r/:id",
      "destination": "/api/r/:id"
    },
    {
      "source": "/api/tasks/:id",
      "destination": "/api/engine"
    },
    {
      "source": "/api/r/:id/advance",
      "destination": "/api/engine"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
